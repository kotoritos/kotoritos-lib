{
  "schemaVersion": 1,
  "id": "kotorito_lib",
  "version": "${version}",
  "name": "Kotorito Lib",
  "description": "Base library mod for Kotoritos ecosystem on Fabric 1.20.1.",
  "authors": [
    "kotoritos"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kotoritos.kotoritolib.KotoritoLib"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": ">=${fabric_api_version}",
    "java": ">=17"
  },
  "custom": {
    "kotorito-lib": {
      "apiVersion": "1.0.0",
      "stability": "stable"
    }
  }
}
